# Personal exclude patterns, merged with the client's system defaults in
# /etc/Nextcloud/sync-exclude.lst (no need to repeat those here).

# Dev build output / dependencies / tooling state — regenerable, and hundreds of
# thousands of tiny files each; syncing them pinned the Pi5's CPU for two days
# (2026-10-04..06). A trailing "/" matches directories only, at any depth.
node_modules/
.git/
obj/
.vs/
.idea/
.gradle/
.dart_tool/
__pycache__/
.venv/
.next/
.nuxt/
.angular/
.parcel-cache/
